{
  "name": "ganaderia",
  "version": "0.1.0",
  "description": "Livestock management backend API",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node scripts/dev.js",
    "db:init": "node scripts/db.js init",
    "db:up": "node scripts/db.js up",
    "db:down": "node scripts/db.js down",
    "db:reset": "node scripts/db.js reset",
    "db:smoke": "node scripts/db.js smoke",
    "db:migrate": "node scripts/migrate.js --db both",
    "test": "vitest run",
    "web:dev": "npm --prefix apps/web run dev",
    "e2e": "playwright test --config test/e2e/playwright.config.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "ultimate-express": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "embedded-postgres": "^18.7.0-beta.19",
    "supertest": "^7.3.2",
    "vitest": "^4.1.12"
  }
}
